# Keep build contexts small and reproducible. The api/worker/web images all use
# the repo root as their build context, so this file governs what they can copy.

# --- VCS / CI ---
.git/
.gitignore
.gitattributes

# --- Python virtualenvs & caches (rebuilt inside the image) ---
**/.venv/
**/venv/
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.ruff_cache/
**/.mypy_cache/
**/*.egg-info/
.uv-cache/

# --- Node / Next.js (reinstalled from the lockfile inside the image) ---
**/node_modules/
**/.next/
**/out/
**/.turbo/
web/tsconfig.tsbuildinfo

# --- dbt build artifacts ---
**/target/
**/dbt_packages/
**/logs/

# --- Generated / heavy data (regenerated by bootstrap/seed) ---
data/generated/
data/ingested/
data/warehouse/
data/qdrant/
data/backups/
**/*.duckdb

# --- Secrets & local runtime state (never bake into an image) ---
.env
.env.*
!.env.example
docker/.data/

# --- Editor / OS noise ---
.idea/
.vscode/
.DS_Store
Thumbs.db
*.swp

# --- Docs & meta not needed at runtime ---
**/README.md
docs/
LICENSE
