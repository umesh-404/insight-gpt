# InsightGPT environment — copy to .env and fill in. Never commit .env.
# Secrets (LLM keys, DB passwords) live here, never in the repo or config/*.yaml.

# --- LLM provider (reasoning step) --------------------------------------------
# One of: ollama (default, local) | openai | groq | gemini(not yet)
LLM_PROVIDER=ollama
LLM_MODEL=llama3.1:8b
OLLAMA_HOST=http://127.0.0.1:11434
# Cloud keys — only needed if LLM_PROVIDER points at that service:
# OPENAI_API_KEY=
# GROQ_API_KEY=

# --- Warehouse ----------------------------------------------------------------
# duckdb (offline fixture) or postgres
WAREHOUSE=duckdb
# POSTGRES_DSN=postgresql://insight_app:CHANGE_ME@localhost:5432/insight

# --- Reference date used to resolve relative time ranges ("last quarter") -----
TODAY=2026-07-15
