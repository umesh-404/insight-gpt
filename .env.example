# InsightGPT environment — copy to .env and fill in. Never commit .env.
# Secrets (LLM keys, DB passwords, JWT secret) live here, never in the repo or
# config/*.yaml.
#
# TWO TOPOLOGIES, ONE FILE. Read this before changing a host or a URL.
#
#   HOST RUN (what the values below describe, and the demo path).
#     The API and web app run directly on your machine, against a Qdrant on
#     127.0.0.1:6333 and an Ollama on 127.0.0.1:11434 that you run yourself.
#     Everything here is read by the app process.
#
#   COMPOSE RUN (`make up`).
#     Six containers on a private network, where the stores are reachable as
#     `http://qdrant:6333`, `http://ollama:11434` and `postgres:5432`. Those
#     service names are correct INSIDE the compose network and wrong outside
#     it, so docker/compose.yml carries them as its OWN defaults and does not
#     read QDRANT_URL / OLLAMA_HOST / WAREHOUSE from this file. One .env
#     therefore serves both, with no editing to switch. To point the compose
#     stack at something external, set STACK_QDRANT_URL / STACK_OLLAMA_HOST /
#     STACK_WAREHOUSE — the only three variables that differ by topology.
#
#   See docs/09-deployment.md §2.0 for the full table of which is which.
#
# THIS FILE IS READ FROM THE REPO ROOT. Bring the compose stack up with
# `make up`, or with a plain `docker compose up --build` from the root (the root
# compose.yaml makes the repo root the compose project directory, which is what
# lets this .env be found). Running `docker compose -f docker/compose.yml up`
# WITHOUT `--env-file .env` reads no .env at all and silently uses the in-file
# defaults — your LLM_PROVIDER below would be ignored.
#
# Check this file against what is actually reachable:
#     python scripts/setup.py --preflight

# --- Host-published ports (override to avoid conflicts) -----------------------
WEB_PORT=3000
API_PORT=8000

# --- LLM provider (reasoning step ONLY) ---------------------------------------
# One of: gemini | openai | groq (cloud, need a key) | ollama (local) | fake (tests).
# Embeddings and reranking do NOT follow this setting: they are always the local
# Ollama models configured below. Only the chat/reasoning step follows it.
#
# PRODUCTION: set APP_ENV=production. That refuses to start on `fake`, refuses a
# cloud provider with no key, and turns an unreachable provider into a 503
# rather than a quietly templated answer.
LLM_PROVIDER=gemini
# Model id. There is no safe evergreen default: provider catalogues are retired
# on a schedule (Groq shut down llama-3.1-8b-instant on 2026-08-16), so this is
# set explicitly and checked against the provider's own /models list at startup.
LLM_MODEL=gemini-2.5-flash

# Cloud key — only the one your LLM_PROVIDER points at is needed. Left blank on
# purpose: the API refuses to start on a cloud provider with no key, which is a
# readable failure at boot instead of a 503 on the first question. Get a Gemini
# key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# OPENAI_API_KEY=
# GROQ_API_KEY=

# Cost + latency ceiling for a single reasoning call.
LLM_MAX_OUTPUT_TOKENS=2048
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=3
# Which field carries that ceiling. Gemini and Groq take `max_tokens`; OpenAI's
# newer reasoning models take only `max_completion_tokens`. Exactly one is sent
# - Gemini rejects the request outright if both are present.
# LLM_MAX_TOKENS_FIELD=max_tokens

# --- Warehouse (structured / text-to-SQL path) --------------------------------
# duckdb (the offline retail fixture — what a host run has) or postgres. The
# compose stack runs postgres from its own default, so leaving this on duckdb
# does NOT downgrade `make up`; the POSTGRES_* values below describe the
# containerised warehouse and are unused by a duckdb host run.
WAREHOUSE=duckdb
# Left EMPTY on purpose, for both topologies at once:
#   * compose substitutes its own identical in-file defaults for an empty value
#     (postgresql://insight:insight@postgres:5432/insight, and the SELECT-only
#     insight_app role for the api service), so `make up` is unaffected;
#   * a host run with WAREHOUSE=duckdb would otherwise register the compose
#     warehouse as a data source and report it permanently unreachable, because
#     the hostname `postgres` does not resolve outside the compose network.
# Set them to a real DSN only when you have a Postgres this process can reach.
# The discrete POSTGRES_* below back dbt's profiles.yml and the seed guard.
POSTGRES_DSN=
APP_POSTGRES_DSN=
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=insight
POSTGRES_PASSWORD=insight
POSTGRES_DB=insight

# --- Retrieval / vector DB (local) --------------------------------------------
# qdrant = real hybrid dense+sparse retrieval with local reranking. `fixture` is
# keyword overlap over six built-in demo documents; it can never see an uploaded
# dataset, so it is for tests and offline runs only.
RETRIEVER=qdrant
# Host run: a Qdrant on loopback. The compose stack uses its own sibling.
QDRANT_URL=http://127.0.0.1:6333
# InsightGPT uses exactly ONE collection, and creates/queries/deletes only
# inside it. A Qdrant instance is often shared with other projects — on this
# machine it also holds another project's `code`, `docs` and `memory`
# collections — so nothing in this repo drops, resets or prunes a collection
# whose name does not start with `insightgpt_`. See docs/04-retrieval-rag.md §7.
QDRANT_COLLECTION=insightgpt_documents

# --- Local models (Ollama: embeddings + reranking) ----------------------------
# Host run: an Ollama on loopback. The compose stack uses its own sibling.
OLLAMA_HOST=http://127.0.0.1:11434
# Embedding backend. "ollama" keeps embedding on this machine: document text is
# embedded here and the vectors are stored here. Only the snippets retrieved for
# a question travel, inside the prompt sent to the reasoning provider above.
#
# "openai" instead talks to any OpenAI-compatible /embeddings endpoint, which is
# what makes real dense retrieval possible on a managed host with nowhere to run
# Ollama — without an embedder, RETRIEVER=qdrant has no way to embed and search
# silently degrades to keyword matching. It also means document text leaves the
# machine, so it is opt-in, never the default:
#   EMBED_PROVIDER=openai
#   EMBED_API_KEY_ENV=GEMINI_API_KEY
#   EMBED_MODEL=gemini-embedding-001
#   EMBED_DIMENSIONS=3072
EMBED_PROVIDER=ollama
EMBED_MODEL=nomic-embed-text
# Vector width of nomic-embed-text. MUST match the Qdrant collection: a mismatch
# is refused rather than written, and changing it needs a full re-index.
EMBED_DIMENSIONS=768
# Local cross-encoder reranker pulled by bootstrap (Ollama has no rerank API).
# Reranking is an enhancement: if this model is missing, search falls back to
# the RRF order instead of failing.
RERANK_MODEL=dengcao/Qwen3-Reranker-0.6B:F16

# What the worker's reindex_docs job indexes:
#   ingested (default) -- the redacted corpus services/ingestion publishes to
#                         data/ingested/documents.json (the real documents)
#   samples            -- the retrieval package's six built-in demo documents
#   <path>             -- a folder or JSON file
# Uploaded datasets are NOT part of this job: they are indexed on upload and
# deleted by a filtered delete on their dataset_id (docs/03-ingestion-etl.md §7.1).
REINDEX_SOURCE=ingested

# --- Data-source registry -----------------------------------------------------
# Where the registry of data sources is persisted so it survives a restart.
# With POSTGRES_DSN set it lives in insight.sources instead and this is unused.
# A connection string is NEVER written here: register a database source with the
# `dsn_env` option (naming an environment variable) if you want it to keep
# working after a restart.
SOURCES_STORE_PATH=data/sources.json

# --- Auth ---------------------------------------------------------------------
# REQUIRED. The API refuses to start without it, and refuses a placeholder or
# anything shorter than 32 bytes, so generate a real one:
#   openssl rand -hex 32
# Leaving it blank is intentional: an example secret gets copied into real
# deployments, and a signing key everyone can read signs everyone's tokens.
# `python scripts/setup.py` generates one for you on first run.
JWT_SECRET=

# --- API / web wiring ---------------------------------------------------------
# Comma-separated browser origin allow-list. It must list EVERY origin the web
# app is served from, including the 3020 port the native dev flow uses — an
# origin missing here fails CORS preflight and login silently stops working
# in the browser. Keep WEB_PORT and this list in step.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3020,http://127.0.0.1:3020
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_USE_MOCK=false

# --- Reference date used to resolve relative time ranges ("last quarter") -----
TODAY=2026-07-15
