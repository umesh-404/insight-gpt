# InsightGPT environment — copy to .env and fill in. Never commit .env.
# Secrets (LLM keys, DB passwords, JWT secret) live here, never in the repo or
# config/*.yaml. Every value below has a safe default baked into
# docker/compose.yml, so the stack also comes up on a bare checkout.
#
# THIS FILE IS READ FROM THE REPO ROOT. Bring the stack up with `make up`, or
# with a plain `docker compose up --build` from the root (the root compose.yaml
# makes the repo root the compose project directory, which is what lets this
# .env be found). Running `docker compose -f docker/compose.yml up` WITHOUT
# `--env-file .env` reads no .env at all and silently uses the in-file defaults
# — your LLM_PROVIDER below would be ignored. See docs/09-deployment.md §2.

# --- Host-published ports (override to avoid conflicts) -----------------------
WEB_PORT=3000
API_PORT=8000

# --- LLM provider (reasoning step) --------------------------------------------
# One of: ollama (default, local) | openai | groq | gemini
# `gemini` is declared but not implemented yet — selecting it raises at startup.
# Embeddings and reranking ALWAYS use local Ollama models regardless of this
# setting; only the chat/reasoning step follows LLM_PROVIDER.
LLM_PROVIDER=ollama
LLM_MODEL=llama3.1:8b
OLLAMA_HOST=http://ollama:11434
# Cloud keys — only needed if LLM_PROVIDER points at that service (leave blank).
# Uncomment and fill; compose passes them through to the api container.
# OPENAI_API_KEY=
# GROQ_API_KEY=

# --- Warehouse ----------------------------------------------------------------
# duckdb (offline fixture) or postgres (the compose stack uses postgres)
WAREHOUSE=postgres
# Single DSN used by the API and ingestion; the discrete POSTGRES_* below back
# dbt's profiles.yml and the seed guard. Keep them consistent.
POSTGRES_DSN=postgresql://insight:insight@postgres:5432/insight
# The API connects as a SELECT-only role instead (created by docker/initdb), so
# a failure of the SQL guardrails still cannot write to the warehouse. dbt and
# ingestion keep the owner DSN above because they must create tables.
APP_POSTGRES_DSN=postgresql://insight_app:insight@postgres:5432/insight
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=insight
POSTGRES_PASSWORD=insight
POSTGRES_DB=insight

# --- Retrieval / vector DB ----------------------------------------------------
# fixture (offline, in-memory) or qdrant (the compose stack uses qdrant)
RETRIEVER=qdrant
QDRANT_URL=http://qdrant:6333
EMBED_MODEL=nomic-embed-text
# Local cross-encoder reranker pulled by bootstrap (Ollama has no rerank API).
# Reranking is an enhancement: if this model is missing, search falls back to
# the RRF order instead of failing.
RERANK_MODEL=dengcao/Qwen3-Reranker-0.6B:F16

# What the worker's reindex_docs job indexes:
#   ingested (default) -- the redacted corpus services/ingestion publishes to
#                         data/ingested/documents.json (the real documents)
#   samples            -- the retrieval package's six built-in demo documents
#   <path>             -- a folder or JSON file
REINDEX_SOURCE=ingested

# --- Auth ---------------------------------------------------------------------
# Generate a long random value for real deployments (e.g. openssl rand -hex 32).
JWT_SECRET=

# --- API / web wiring ---------------------------------------------------------
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_USE_MOCK=false

# --- Reference date used to resolve relative time ranges ("last quarter") -----
TODAY=2026-07-15
