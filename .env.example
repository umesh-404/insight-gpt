# InsightGPT environment — copy to .env and fill in. Never commit .env.
# Secrets (LLM keys, DB passwords, JWT secret) live here, never in the repo or
# config/*.yaml. Every value below has a safe default baked into
# docker/compose.yml, so the stack also comes up on a bare checkout.

# --- Host-published ports (override to avoid conflicts) -----------------------
WEB_PORT=3000
API_PORT=8000

# --- LLM provider (reasoning step) --------------------------------------------
# One of: ollama (default, local) | openai | gemini | groq
LLM_PROVIDER=ollama
LLM_MODEL=llama3.1:8b
OLLAMA_HOST=http://ollama:11434
# Cloud keys — only needed if LLM_PROVIDER points at that service (leave blank):
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# GROQ_API_KEY=

# --- Warehouse ----------------------------------------------------------------
# duckdb (offline fixture) or postgres (the compose stack uses postgres)
WAREHOUSE=postgres
# Single DSN used by the API and ingestion; the discrete POSTGRES_* below back
# dbt's profiles.yml and the seed guard. Keep them consistent.
POSTGRES_DSN=postgresql://insight:insight@postgres:5432/insight
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=insight
POSTGRES_PASSWORD=insight
POSTGRES_DB=insight

# --- Retrieval / vector DB ----------------------------------------------------
# fixture (offline, in-memory) or qdrant (the compose stack uses qdrant)
RETRIEVER=qdrant
QDRANT_URL=http://qdrant:6333
EMBED_MODEL=nomic-embed-text
# Local cross-encoder reranker pulled by bootstrap (Ollama has no rerank API).
RERANK_MODEL=dengcao/Qwen3-Reranker-0.6B:F16

# --- Auth ---------------------------------------------------------------------
# Generate a long random value for real deployments (e.g. openssl rand -hex 32).
JWT_SECRET=

# --- API / web wiring ---------------------------------------------------------
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_USE_MOCK=false

# --- Reference date used to resolve relative time ranges ("last quarter") -----
TODAY=2026-07-15
