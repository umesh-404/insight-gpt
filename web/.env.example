# InsightGPT frontend environment — copy to .env.local and adjust.

# Base URL of the FastAPI backend (see docs/06-api.md). Include the version prefix.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# When "true", the UI serves a realistic answer envelope + dashboard/pipeline
# fixtures from lib/mock.ts so every screen renders without a running backend.
# Set to "false" (or remove) to talk to the real API.
NEXT_PUBLIC_USE_MOCK=true
