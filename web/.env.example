# InsightGPT frontend environment — copy to .env.local and adjust.

# Base URL of the FastAPI backend. Include the version prefix.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Demo mode. When "true", every API call resolves from lib/mock.ts fixtures so
# the UI renders without a backend. Anything other than the exact string "true"
# (including leaving it unset) talks to the real API — mock data must never
# appear in a real-mode screen.
NEXT_PUBLIC_USE_MOCK=false
